{
  "name": "cross-user-ram",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/memory.test.ts",
    "build": "node scripts/build.mjs && node scripts/build-codex.mjs",
    "build:codex": "node scripts/build-codex.mjs",
    "test:packages": "node --import tsx --test tests/packages.test.ts",
    "test:live": "node --import tsx scripts/live-test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:packages"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@redis-iris/agent-memory": "0.2.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
