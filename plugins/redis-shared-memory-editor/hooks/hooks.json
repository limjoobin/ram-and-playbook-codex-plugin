{
  "description": "Capture private prompts, flag possible lifecycle updates, and record session-end markers. No hook publishes shared memory.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ${PLUGIN_ROOT}/hooks/capture.py",
            "timeout": 4,
            "statusMessage": "Capturing private memory intent",
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ${PLUGIN_ROOT}/hooks/capture.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
