RAM_ENDPOINT=https://your-memory-endpoint.redis.io
RAM_STORE_ID=shared-store
RAM_NAMESPACE=shared-namespace
# Set a different participant value for every person. This is attribution, not authentication.
RAM_PARTICIPANT=your-user-id
# Use a per-user key when the RAM service supports one. Never paste it into chat or commit it.
RAM_API_KEY=
# Owner lane containing the organizational_state records extracted for the agenda workflow.
RAM_AGENDA_OWNER_ID=ami-project-office
# Full Playbook MCP URL, including /v1/playbooks/{playbookId}/mcp.
PLAYBOOK_MCP_URL=http://127.0.0.1:9201/v1/playbooks/your-playbook-id/mcp
PLAYBOOK_API_KEY=
