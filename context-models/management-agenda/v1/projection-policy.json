  "resolution": "latest-source-event-wins-unless-conflict-is-at-or-after-the-current-frontier",
  "relationPolicy": {
    "allowedPredicates": [
      "fulfills",
      "resolves",
      "supersedes",
      "blocks",
      "depends_on",
      "conflicts_with",
      "supports"
    ],
    "confirmationStatus": "confirmed",
