      {
        "predicate": "fulfills",
        "targetKinds": ["action_item"],
        "targetStatus": "completed"
      },
      {
        "predicate": "resolves",
        "targetKinds": ["risk", "issue", "conflict"],
        "targetStatus": "resolved"
      },
      {
        "predicate": "supersedes",
        "targetKinds": [
          "action_item",
          "decision",
          "risk",
          "issue",
          "dependency",
          "approval",
          "conflict"
        ],
        "targetStatus": "superseded"
      }
    ]
  },
