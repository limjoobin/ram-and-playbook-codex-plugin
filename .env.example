# Copy to ~/.config/redis-shared-memory/editor.env and run: chmod 600 ~/.config/redis-shared-memory/editor.env
# Never paste a key into chat or commit this file populated.

# Redis Agent Memory data-plane base URL, store ID, and API key.
IRIS_AGENT_MEMORY_URL=https://your-region.memory.redis.io
IRIS_AGENT_MEMORY_STORE_ID=st_your-store-id
IRIS_AGENT_MEMORY_API_KEY=

# Shared namespace used by the team.
RAM_NAMESPACE=shared-namespace
# Optional; defaults to private-{RAM_PARTICIPANT}.
RAM_PERSONAL_NAMESPACE=private-your-user-id
# Set a different participant value for every person. This is attribution, not authentication.
RAM_PARTICIPANT=your-user-id
# Owner lane containing the organizational_state records extracted for the agenda workflow.
RAM_AGENDA_OWNER_ID=ami-project-office
# Optional. How management records are stored in RAM custom memory types:
# compact (default) uses one 9-field organizational_state type; expanded uses the
# original organizational_state and organizational_state_projection types.
# RAM_MEMORY_LAYOUT=compact

# Folders (absolute, ':'-separated) whose sessions the private-capture hooks
# may record. Empty records nothing. setup_demo.py sets the project folder.
# RAM_CAPTURE_FOLDERS=/path/to/ram-and-playbook-codex-plugin

# Agent Playbooks data-plane base URL only (no /iris/data/v1/agent-playbooks/... path; the SDK appends it).
# Loopback http://127.0.0.1 is accepted for local development only.
IRIS_AGENT_PLAYBOOKS_URL=https://your-playbook-endpoint.redis.io
IRIS_AGENT_PLAYBOOKS_PLAYBOOK_ID=pb_your-playbook-id
# Runtime reader key (read-only).
IRIS_AGENT_PLAYBOOKS_API_KEY=

# Optional administrator names. The desktop MCP accepts these but never copies
# them into its runtime Config. Leave them unset for participant-only installs.
# Read/write/publish key used by `iris agent-playbooks skills ...` to publish the Skill.
# IRIS_AGENT_PLAYBOOKS_CONTENT_API_KEY=
# IRIS_AGENT_PLAYBOOKS_SERVICE_URL=
# IRIS_AGENT_PLAYBOOKS_SERVICE_TOKEN=
# IRIS_AGENT_MEMORY_SERVICE_URL=
# IRIS_AGENT_MEMORY_SERVICE_TOKEN=
